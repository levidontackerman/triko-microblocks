module UglyBot Output
author 'Myndsets'
version 1 3
tags robot motor esp32 tb6612 uglybot wifi joystick ultrasonic
choices uglybot_move forward backward 'turn left' 'turn right' 'spin left' 'spin right'
choices uglybot_wheel left right both
choices uglybot_stopmode brake coast
description 'Easy blocks for the Myndsets UglyBot two-wheel rover (ESP32 + TB6612FNG motor driver + HC-SR04 ultrasonic sensor).

Wiring (ESP32 GPIO numbers, Myndsets Two-Wheel Rover pin map):
LEFT motor (A, AO1/AO2): PWMA 25, AIN1 26, AIN2 27
RIGHT motor (B, BO1/BO2): PWMB 14, BIN1 18, BIN2 19
STBY 13 (the library switches it HIGH to turn the driver on)
Ultrasonic: TRIG 22, ECHO 34 through the 1 k / 2 k divider

GPIO 25 and 26 have no PWM in MicroBlocks (they are DAC pins), so the left speed pin is held HIGH and the left wheel speed is sent on AIN2 (GPIO 27) instead. This is automatic.

Speed is -100 to 100 %. Positive = forward, negative = backward, 0 = brake.
If a wheel turns the wrong way, use "flip wheel direction".
If UglyBot drifts, lower the faster wheel with "set wheel balance".
The four "at full speed" blocks keep moving until a stop block runs.

Web joystick: "start web joystick" makes UglyBot a WiFi hotspot. Join that WiFi on a phone and open http://192.168.4.1 to get a joystick and a STOP button. The block keeps running, so put it last in a script (for example under "when started"). If the phone stops talking to UglyBot for 1.5 seconds, UglyBot stops.

Ultrasonic: "UglyBot distance (cm)" reports the distance to the nearest thing in front (400 = nothing in range). "obstacle closer than" is true or false, so it fits in "if" and "when" blocks.
'
variables _uglybot_ready _uglybot_pwmL _uglybot_in1L _uglybot_in2L _uglybot_pwmR _uglybot_in1R _uglybot_in2R _uglybot_stby _uglybot_flipL _uglybot_flipR _uglybot_balL _uglybot_balR _uglybot_trig _uglybot_echo _uglybot_sonarLast _uglybot_sonarMisses _uglybot_sonarTime _uglybot_webMoving _uglybot_webTime

  spec ' ' 'uglybot_go' 'go _ at speed _ %' 'menu.uglybot_move num' 'forward' 50
  spec ' ' 'uglybot_goFor' 'go _ at speed _ % for _ ms' 'menu.uglybot_move num num' 'forward' 50 1000
  spec ' ' 'uglybot_stop' 'stop UglyBot'
  space
  spec ' ' 'uglybot_straightFull' 'go straight at full speed'
  spec ' ' 'uglybot_reverseFull' 'reverse at full speed'
  spec ' ' 'uglybot_leftFull' 'turn left at full speed'
  spec ' ' 'uglybot_rightFull' 'turn right at full speed'
  space
  spec ' ' 'uglybot_setWheels' 'set left wheel _ % right wheel _ %' 'num num' 50 50
  spec ' ' 'uglybot_setWheel' 'set _ wheel speed to _ %' 'menu.uglybot_wheel num' 'left' 50
  spec ' ' 'uglybot_stopWith' 'stop UglyBot with _' 'menu.uglybot_stopmode' 'brake'
  space
  spec ' ' 'uglybot_webJoystick' 'start web joystick WiFi name _ password _' 'str str' 'UglyBot' '12345678'
  space
  spec 'r' 'uglybot_distance' 'UglyBot distance (cm)'
  spec 'r' 'uglybot_obstacle' 'obstacle closer than _ cm' 'num' 15
  space
  spec ' ' 'uglybot_flipWheel' 'flip _ wheel direction _' 'menu.uglybot_wheel bool' 'left' true
  spec ' ' 'uglybot_setBalance' 'set wheel balance left _ % right _ %' 'num num' 100 100
  spec ' ' 'uglybot_setPins' 'set UglyBot pins left PWM _ IN1 _ IN2 _ right PWM _ IN1 _ IN2 _ standby _' 'num num num num num num num' 25 26 27 14 18 19 13
  spec ' ' 'uglybot_setSonarPins' 'set ultrasonic pins trig _ echo _' 'num num' 22 34
  spec ' ' '_uglybot_init' '_uglybot_init'
  spec ' ' '_uglybot_wake' '_uglybot_wake'
  spec ' ' '_uglybot_drive' '_uglybot_drive pwm _ in1 _ in2 _ speed _ balance _ flip _' 'num num num num num bool' 25 26 27 0 100 false
  spec 'r' '_uglybot_pwmOK' '_uglybot_pwmOK _' 'num' 27
  spec ' ' '_uglybot_inPin' '_uglybot_inPin _ level _' 'num num' 27 0
  spec ' ' '_uglybot_coast' '_uglybot_coast pwm _ in1 _ in2 _' 'num num num' 25 26 27
  spec ' ' '_uglybot_left' '_uglybot_left _' 'num' 0
  spec ' ' '_uglybot_right' '_uglybot_right _' 'num' 0
  spec ' ' '_uglybot_coastAll' '_uglybot_coastAll'
  spec 'r' '_uglybot_sonarPulse' '_uglybot_sonarPulse'
  spec ' ' '_uglybot_webHandle' '_uglybot_webHandle _' 'str' ''
  spec ' ' '_uglybot_webDrive' '_uglybot_webDrive _' 'str' '/d/200/200'
  spec 'r' '_uglybot_page' '_uglybot_page'
  spec 'r' '_uglybot_page1' '_uglybot_page1'
  spec 'r' '_uglybot_page2' '_uglybot_page2'
  spec 'r' '_uglybot_page3' '_uglybot_page3'
  spec 'r' '_uglybot_page4' '_uglybot_page4'

to '_uglybot_coast' pwm in1 in2 {
  comment 'IN1 = IN2 = LOW: the motor free-wheels.'
  if ('_uglybot_pwmOK' pwm) {
    digitalWriteOp in1 false
    digitalWriteOp in2 false
  } else {
    '_uglybot_inPin' in1 0
    '_uglybot_inPin' in2 0
  }
}

to '_uglybot_coastAll' {
  '_uglybot_coast' _uglybot_pwmL _uglybot_in1L _uglybot_in2L
  '_uglybot_coast' _uglybot_pwmR _uglybot_in1R _uglybot_in2R
}

to '_uglybot_drive' pwm in1 in2 speed balance flip {
  comment 'One TB6612 channel. speed -100..100, 0 = brake.'
  speed = (maximum -100 (minimum 100 speed))
  if flip {
    speed = (0 - speed)
  }
  local 'duty' ((((absoluteValue speed) * balance) * 1023) / 10000)
  if ('_uglybot_pwmOK' pwm) {
    comment 'Normal: direction on IN1/IN2, PWM on the PWM pin.'
    if (duty < 1) {
      digitalWriteOp in1 true
      digitalWriteOp in2 true
      analogWriteOp pwm 0
    } (speed > 0) {
      digitalWriteOp in1 true
      digitalWriteOp in2 false
      analogWriteOp pwm duty
    } else {
      digitalWriteOp in1 false
      digitalWriteOp in2 true
      analogWriteOp pwm duty
    }
  } else {
    comment 'PWM pin is GPIO 25/26 (no PWM): hold it HIGH, PWM an IN pin.'
    digitalWriteOp pwm true
    if (duty < 1) {
      '_uglybot_inPin' in1 1023
      '_uglybot_inPin' in2 1023
    } (speed > 0) {
      if ('_uglybot_pwmOK' in2) {
        '_uglybot_inPin' in1 1023
        '_uglybot_inPin' in2 (1023 - duty)
      } else {
        '_uglybot_inPin' in2 0
        '_uglybot_inPin' in1 duty
      }
    } else {
      if ('_uglybot_pwmOK' in1) {
        '_uglybot_inPin' in2 1023
        '_uglybot_inPin' in1 (1023 - duty)
      } else {
        '_uglybot_inPin' in1 0
        '_uglybot_inPin' in2 duty
      }
    }
  }
}

to '_uglybot_inPin' pin level {
  comment 'Used when the PWM pin is a DAC pin. level 0-1023. PWM-capable pins get PWM; GPIO 25/26 get plain HIGH/LOW.'
  if ('_uglybot_pwmOK' pin) {
    analogWriteOp pin level
  } else {
    digitalWriteOp pin (level > 511)
  }
}

to '_uglybot_init' {
  comment 'Default pins from the Myndsets Two-Wheel Rover (ESP32) pin map.'
  if (_uglybot_ready == 0) {
    _uglybot_pwmL = 25
    _uglybot_in1L = 26
    _uglybot_in2L = 27
    _uglybot_pwmR = 14
    _uglybot_in1R = 18
    _uglybot_in2R = 19
    _uglybot_stby = 13
    _uglybot_trig = 22
    _uglybot_echo = 34
    _uglybot_flipL = false
    _uglybot_flipR = false
    _uglybot_balL = 100
    _uglybot_balR = 100
    _uglybot_sonarLast = 400
    _uglybot_ready = 1
    '_uglybot_coastAll'
    '_uglybot_wake'
  }
}

to '_uglybot_left' speed {
  '_uglybot_drive' _uglybot_pwmL _uglybot_in1L _uglybot_in2L speed _uglybot_balL _uglybot_flipL
}

to '_uglybot_page' {
  comment 'The joystick web page. It is stored in pieces because one MicroBlocks script can only hold about 1000 bytes.'
  return ('[data:join]' ('[data:join]' ('_uglybot_page1') ('_uglybot_page2')) ('[data:join]' ('_uglybot_page3') ('_uglybot_page4')))
}

to '_uglybot_page1' {
  return '<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"><title>UglyBot</title><style>body{margin:0;background:#12151c;color:#fff;font-family:sans-serif;text-align:center;touch-action:none;user-select:none;-webkit-user-select:none}h2{margin:14px 0 2px}#t{color:#9aa7bd}#p{width:260px;height:260px;margin:16px auto;border-radius:50%;background:#232a38;border:3px solid #3d4a63;position:relative}#k{width:96px;height:96px;border-radius:50%;background:#ffb300;position:absolute;left:82px;top:82px}#b{width:240px;padding:22px 0;font-size:30px;font-weight:bold;'
}

to '_uglybot_page2' {
  return 'color:#fff;background:#e53935;border:0;border-radius:16px}</style></head><body><h2>UglyBot</h2><div id="t">drag the stick to drive</div><div id="p"><div id="k"></div></div><button id="b">STOP</button><script>var p=document.getElementById("p"),k=document.getElementById("k"),t=document.getElementById("t"),L=0,R=0,sent="",busy=0,down=0,last=0;function put(x,y){k.style.left=(82+x*85)+"px";k.style.top=(82-y*85)+"px"}function mv(e){if(!down)return;var r=p.getBoundingClientRect(),x=(e.clientX-r.left-130)/85,y=(130-e.clientY+r.top)/85,m=Math.sqrt(x*x+y*y);if(m>1){x/=m;y/=m}put(x,y);if(Math.abs(x)<.15)x=0;'
}

to '_uglybot_page3' {
  return 'if(Math.abs(y)<.15)y=0;var l=y+x,q=y-x,s=Math.max(1,Math.abs(l),Math.abs(q));L=Math.round(l/s*100);R=Math.round(q/s*100)}function up(){down=0;L=0;R=0;put(0,0)}p.onpointerdown=function(e){down=1;p.setPointerCapture(e.pointerId);mv(e)};p.onpointermove=mv;p.onpointerup=up;p.onpointercancel=up;document.getElementById("b").onclick=function(){up();sent=""};function tick(){var u="/d/"+(L+200)+"/"+(R+200),n=Date.now();if(busy&&n-last<1500)return;if(u==sent&&(n-last<400||!(L||R)))return;busy=1;sent=u;last=n;fetch(u).then(function(){busy=0;t.textContent="connected"},function(){busy=0;sent="";'
}

to '_uglybot_page4' {
  return 't.textContent="no link - join the UglyBot WiFi"})}setInterval(tick,80)</script></body></html>'
}

to '_uglybot_pwmOK' pin {
  comment 'false for GPIO 25 and 26: MicroBlocks drives them as DAC outputs, not PWM.'
  return (not (or (pin == 25) (pin == 26)))
}

to '_uglybot_right' speed {
  '_uglybot_drive' _uglybot_pwmR _uglybot_in1R _uglybot_in2R speed _uglybot_balR _uglybot_flipR
}

to '_uglybot_sonarPulse' {
  comment 'Send a 50 usec pulse on TRIG, then capture the echo pulse. Same method as the MicroBlocks HC-SR04 library.'
  digitalWriteOp _uglybot_trig false
  waitMicros 2
  digitalWriteOp _uglybot_trig true
  waitMicros 50
  digitalWriteOp _uglybot_trig false
  '[sensors:captureStart]' _uglybot_echo
  local 'start' (millisOp)
  repeatUntil (or (('[sensors:captureCount]') >= 2) ((absoluteValue ((millisOp) - start)) > 24)) {
    waitMillis 1
  }
  return ('[sensors:captureEnd]')
}

to '_uglybot_wake' {
  comment 'STBY HIGH switches the TB6612FNG on. Use -1 if STBY is wired straight to VCC.'
  if (_uglybot_stby >= 0) {
    digitalWriteOp _uglybot_stby true
  }
}

to '_uglybot_webDrive' path {
  comment 'path is /d/LEFT/RIGHT. Each speed arrives as 100-300 (200 = stopped), so a broken message is ignored.'
  local 'k' ('[data:find]' '/' path 4)
  if (k < 5) {
    return 0
  }
  local 'left' (('[data:copyFromTo]' path 4 (k - 1)) + 0)
  local 'right' (('[data:copyFromTo]' path (k + 1) (size path)) + 0)
  if (or (or (left < 100) (left > 300)) (or (right < 100) (right > 300))) {
    return 0
  }
  '_uglybot_left' (left - 200)
  '_uglybot_right' (right - 200)
  _uglybot_webMoving = (or (left != 200) (right != 200))
  _uglybot_webTime = (millisOp)
}

to '_uglybot_webHandle' request {
  comment '/ is the joystick page, /d/... is a drive message.'
  local 'more' request
  repeatUntil (or (not (isType more 'string')) ((size more) < 800)) {
    more = ('[net:httpServerGetRequest]')
  }
  local 'i' ('[data:find]' ' ' request)
  local 'j' ('[data:find]' ' HTTP' request)
  if (or (i < 1) (j <= (i + 1))) {
    '[net:respondToHttpRequest]' '400 Bad Request'
    return 0
  }
  local 'path' ('[data:copyFromTo]' request (i + 1) (j - 1))
  if (('[data:find]' '/d/' path) == 1) {
    '_uglybot_webDrive' path
    '[net:respondToHttpRequest]' '200 OK' 'ok'
  } (path == '/') {
    '[net:respondToHttpRequest]' '200 OK' ('_uglybot_page') 'Content-Type: text/html'
  } else {
    '[net:respondToHttpRequest]' '404 Not Found'
  }
}

to uglybot_distance {
  comment 'Distance in cm from the HC-SR04. 400 = nothing in range.'
  '_uglybot_init'
  if ((absoluteValue ((millisOp) - _uglybot_sonarTime)) < 30) {
    comment 'The sensor needs a short rest between pings, so reuse the last reading.'
    return _uglybot_sonarLast
  }
  local 'pulses' ('_uglybot_sonarPulse')
  _uglybot_sonarTime = (millisOp)
  if (and ((size pulses) >= 2) ((at 2 pulses) > 0)) {
    _uglybot_sonarMisses = 0
    _uglybot_sonarLast = ((10 * (at 2 pulses)) / 583)
  } else {
    comment 'No echo. Keep the last reading for a few misses, then report 400 (out of range).'
    _uglybot_sonarMisses += 1
    if (_uglybot_sonarMisses >= 10) {
      _uglybot_sonarLast = 400
    }
  }
  return _uglybot_sonarLast
}

to uglybot_flipWheel wheel on {
  '_uglybot_init'
  if (or (wheel == 'left') (wheel == 'both')) {
    _uglybot_flipL = on
  }
  if (or (wheel == 'right') (wheel == 'both')) {
    _uglybot_flipR = on
  }
}

to uglybot_go move speed {
  '_uglybot_init'
  local 's' (minimum 100 (absoluteValue speed))
  if (move == 'forward') {
    '_uglybot_left' s
    '_uglybot_right' s
  } (move == 'backward') {
    '_uglybot_left' (0 - s)
    '_uglybot_right' (0 - s)
  } (move == 'turn left') {
    '_uglybot_left' 0
    '_uglybot_right' s
  } (move == 'turn right') {
    '_uglybot_left' s
    '_uglybot_right' 0
  } (move == 'spin left') {
    '_uglybot_left' (0 - s)
    '_uglybot_right' s
  } (move == 'spin right') {
    '_uglybot_left' s
    '_uglybot_right' (0 - s)
  }
}

to uglybot_goFor move speed ms {
  uglybot_go move speed
  waitMillis (maximum 0 ms)
  uglybot_stop
}

to uglybot_obstacle cm {
  local 'd' (uglybot_distance)
  return (and (d > 0) (d < cm))
}

to uglybot_leftFull {
  uglybot_go 'turn left' 100
}

to uglybot_reverseFull {
  uglybot_go 'backward' 100
}

to uglybot_rightFull {
  uglybot_go 'turn right' 100
}

to uglybot_setBalance left right {
  '_uglybot_init'
  _uglybot_balL = (maximum 0 (minimum 100 left))
  _uglybot_balR = (maximum 0 (minimum 100 right))
}

to uglybot_setPins pwmL in1L in2L pwmR in1R in2R stby {
  '_uglybot_init'
  _uglybot_pwmL = pwmL
  _uglybot_in1L = in1L
  _uglybot_in2L = in2L
  _uglybot_pwmR = pwmR
  _uglybot_in1R = in1R
  _uglybot_in2R = in2R
  _uglybot_stby = stby
  '_uglybot_coastAll'
  '_uglybot_wake'
}

to uglybot_setSonarPins trig echo {
  '_uglybot_init'
  _uglybot_trig = trig
  _uglybot_echo = echo
}

to uglybot_setWheel wheel speed {
  '_uglybot_init'
  if (or (wheel == 'left') (wheel == 'both')) {
    '_uglybot_left' speed
  }
  if (or (wheel == 'right') (wheel == 'both')) {
    '_uglybot_right' speed
  }
}

to uglybot_setWheels left right {
  '_uglybot_init'
  '_uglybot_left' left
  '_uglybot_right' right
}

to uglybot_straightFull {
  uglybot_go 'forward' 100
}

to uglybot_stop {
  '_uglybot_init'
  '_uglybot_left' 0
  '_uglybot_right' 0
}

to uglybot_stopWith mode {
  '_uglybot_init'
  if (mode == 'coast') {
    '_uglybot_coastAll'
  } else {
    uglybot_stop
  }
}

to uglybot_webJoystick name password {
  comment 'WiFi hotspot + joystick page at http://192.168.4.1 . Keeps running: put it last in a script.'
  '_uglybot_init'
  uglybot_stop
  if (not ('[net:hasWiFi]')) {
    sayIt 'This board has no WiFi'
    return 0
  }
  if ((size password) < 8) {
    sayIt 'WiFi password needs 8+ characters'
    return 0
  }
  '[net:startWiFi]' name password true
  if ('Connected' != ('[net:wifiStatus]')) {
    sayIt 'Could not create hotspot'
    return 0
  }
  sayIt 'Join WiFi' name 'then open' ('[net:myIPAddress]')
  _uglybot_webMoving = false
  forever {
    local 'request' ('[net:httpServerGetRequest]')
    if (and (isType request 'string') ((size request) > 0)) {
      '_uglybot_webHandle' request
    } else {
      if (and _uglybot_webMoving ((absoluteValue ((millisOp) - _uglybot_webTime)) > 1500)) {
        comment 'Safety stop: phone silent for 1.5 s.'
        uglybot_stop
        _uglybot_webMoving = false
      }
      waitMillis 5
    }
  }
}
